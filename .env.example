# Anon key only. It is a public key by design — every table it can reach is
# protected by RLS and column grants (§3.1), which is what makes that safe.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key. The OTP endpoint is open the moment you
# deploy (§5.1) — do not ship without this.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_DEFAULT_CITY=bengaluru
